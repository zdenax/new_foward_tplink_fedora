[Unit]
Description=Internet Forwarding Service (Fedora → AP)
After=network-online.target firewalld.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/home/zdenek/claude/new_foward_tplink/setup.sh
ExecStop=/home/zdenek/claude/new_foward_tplink/stop.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
